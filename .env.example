# Zabora subscription-service — variables de entorno (ejemplo)
# Copia a .env y carga según tu IDE / docker-compose. No commitees .env con secretos.

# Puerto HTTP del microservicio
PORT=8004

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/zabora_subscriptions?sslMode=DISABLED&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=cambiar

# Consul (descubrimiento Feign → auth-service)
CONSUL_HOST=localhost
CONSUL_PORT=8500

# JWT (mismo valor Base64 que auth-service)
JWT_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_ENVIRONMENT=test
MP_WEBHOOK_SECRET=
MP_WEBHOOK_NOTIFICATION_URL=https://tu-tunel-o-dominio/api/webhooks/mercadopago
MP_SUCCESS_URL=http://localhost:4200/suscripciones/exito
MP_FAILURE_URL=http://localhost:4200/suscripciones/checkout?payment=failure
MP_PENDING_URL=http://localhost:4200/suscripciones/checkout?payment=pending

# Correo (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SEND_FACTURA=true
EMAIL_ADMIN_NOTIFY=false
EMAIL_ADMIN_RECIPIENTS=

# Feign directo a auth si no usas Consul:
# SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_AUTH-SERVICE_URL=http://127.0.0.1:8000
