
# Puerto HTTP del microservicio
PORT=8004

# MySQL (en producción usa SSL según tu proveedor)
MYSQL_URL=jdbc:mysql://localhost:3306/zabora_subscriptions?sslMode=DISABLED&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=cambiar

# Consul (descubrimiento; Feign resuelve auth-service vía Consul)
CONSUL_HOST=localhost
CONSUL_PORT=8500

# JWT — mismo valor Base64 que auth-service (jwt.secret) y Gateway (JWT_SECRET_KEY / security.jwt.secret-key)
JWT_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_ENVIRONMENT=test
MP_WEBHOOK_SECRET=
# URL pública que apunta al API Gateway (Mercado Pago hace POST aquí)
MP_WEBHOOK_NOTIFICATION_URL=https://tu-dominio.com/api/webhooks/mercadopago
MP_SUCCESS_URL=https://tu-dominio.com/suscripciones/exito
MP_FAILURE_URL=https://tu-dominio.com/suscripciones/checkout?payment=failure
MP_PENDING_URL=https://tu-dominio.com/suscripciones/checkout?payment=pending

# Correo (opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_SEND_FACTURA=true
EMAIL_ADMIN_NOTIFY=false
EMAIL_ADMIN_RECIPIENTS=

# Si Consul no resuelve auth-service, URL directa (descomenta y ajusta puerto):
# En Spring Boot 3 la propiedad es spring.cloud.openfeign.client.config.auth-service.url
# SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_AUTH-SERVICE_URL=http://127.0.0.1:8000

# Opcional: logging / JPA
# JPA_SHOW_SQL=false
# LOG_LEVEL_SUBSCRIPTION=INFO
# APP_MODE=production
