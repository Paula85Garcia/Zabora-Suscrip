secrets.json
*.pem
*.key
*.crt
config/secrets/

# ========== MAVEN ==========
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ========== INTELLIJ IDEA ==========
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# ========== ECLIPSE ==========
.classpath
.project
.settings/
bin/
.metadata
.recommenders

# ========== VSCODE ==========
