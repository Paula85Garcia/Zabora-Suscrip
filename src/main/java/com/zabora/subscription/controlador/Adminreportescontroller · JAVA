/**
 * Controlador de administración para reportes y estadísticas
 * 
 * IMPORTANTE: Los roles se validan manualmente desde UserContext
 * porque API Gateway ya validó el JWT y agregó los headers.
 * 
 * API Gateway agrega:
 * - X-User-Id
 * - X-User-Email
 * - X-User-Role (ADMIN, USER)
 * 
 * UserContextFilter los extrae y los pone en UserContext.
 */
@Slf4j
@RestController
@RequestMapping("/api/admin")
@RequiredArgsConstructor
@Tag(name = "Admin - Reportes", description = "Endpoints administrativos para reportes y estadísticas")
public class AdminReportesController {

    private final AdminReportesServicio adminReportesServicio;

    /**
     * Validar que el usuario tenga rol ADMIN
     * Lanza excepción si no es admin
     */
    private void validarRolAdmin() {
        try {
            String role = UserContext.get().getRole();
            
            log.debug("Validando rol: {}", role);
            
            // Verificar que sea ADMIN
            if (role == null || (!role.equals("ADMIN") && !role.equals("ROLE_ADMIN"))) {
                log.warn("Acceso denegado: usuario con rol {} intentó acceder a endpoint de admin", role);
                throw new SecurityException("Acceso denegado: se requiere rol ADMIN");
            }
            
            log.debug("Rol ADMIN validado correctamente");
            
        } catch (Exception e) {
            log.error("Error validando rol de administrador", e);
            throw new SecurityException("Acceso denegado: " + e.getMessage());
        }
    }

