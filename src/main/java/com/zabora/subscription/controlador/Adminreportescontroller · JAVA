    /**
     * Cancelar suscripción manualmente
     */
    @PostMapping("/suscripciones/{id}/cancelar")
    @Operation(summary = "Cancelar suscripción (admin)", 
               description = "Permite al admin cancelar una suscripción manualmente")
    public ResponseEntity<Map<String, Object>> cancelarSuscripcionAdmin(
            @PathVariable String id,
            @RequestParam(defaultValue = "false") boolean inmediata,
            @RequestParam(required = false) String motivo) {
        
        log.info("Admin cancelando suscripción: {}, inmediata: {}", id, inmediata);
        
        try {
            adminReportesServicio.cancelarSuscripcionAdmin(id, inmediata, motivo);
            
            Map<String, Object> response = new HashMap<>();
            response.put("success", true);
            response.put("mensaje", "Suscripción cancelada por administrador");
            response.put("suscripcionId", id);
            response.put("inmediata", inmediata);
            
            log.info("Suscripción {} cancelada por admin", id);
            return ResponseEntity.ok(response);
            
        } catch (Exception e) {
            log.error("Error cancelando suscripción", e);
            
            Map<String, Object> error = new HashMap<>();
            error.put("success", false);
            error.put("error", e.getMessage());
            
            return ResponseEntity.internalServerError().body(error);
        }
    }

