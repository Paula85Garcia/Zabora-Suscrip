    /**
     * Obtener logs de suscripciones
     */
    @GetMapping("/logs/suscripciones")
    @Operation(summary = "Logs de suscripciones", 
               description = "Retorna los logs de cambios en suscripciones")
    public ResponseEntity<List<Map<String, Object>>> obtenerLogsSuscripciones(
            @RequestParam(required = false) String suscripcionId,
            @RequestParam(defaultValue = "50") int limite) {
        
        log.info("Admin solicitó logs de suscripciones");
        
        try {
            List<Map<String, Object>> logs;
            
            if (suscripcionId != null) {
                logs = adminReportesServicio.obtenerLogsPorSuscripcion(suscripcionId, limite);
            } else {
                logs = adminReportesServicio.obtenerLogsRecientes(limite);
            }
            
            log.info("Retornando {} logs", logs.size());
            return ResponseEntity.ok(logs);
            
        } catch (Exception e) {
            log.error("Error obteniendo logs", e);
            return ResponseEntity.internalServerError().build();
        }
    }

    /**
     * Obtener detalles de una suscripción específica
     */
    @GetMapping("/suscripciones/{id}/detalles")
    @Operation(summary = "Detalles de suscripción", 
               description = "Retorna información completa de una suscripción")
    public ResponseEntity<Map<String, Object>> obtenerDetallesSuscripcion(
            @PathVariable String id) {
        
        log.info("Admin solicitó detalles de suscripción: {}", id);
        
        try {
            Map<String, Object> detalles = 
                adminReportesServicio.obtenerDetallesSuscripcion(id);
            
            log.info("Detalles de suscripción obtenidos");
            return ResponseEntity.ok(detalles);
            
        } catch (Exception e) {
            log.error("Error obteniendo detalles de suscripción", e);
            
            Map<String, Object> error = new HashMap<>();
            error.put("error", "Suscripción no encontrada");
            error.put("suscripcionId", id);
            
            return ResponseEntity.notFound().build();
        }
    }

