    // DASHBOARD GENERAL
    // ═══════════════════════════════════════

    /**
     * Obtener dashboard general con métricas principales
     */
    @GetMapping("/dashboard")
    @Operation(summary = "Dashboard general", 
               description = "Retorna métricas principales para el dashboard de admin")
    public ResponseEntity<Map<String, Object>> obtenerDashboard() {
        // Validar rol ADMIN
        validarRolAdmin();
        
        log.info("Admin solicitó dashboard general");
        
        try {
            Map<String, Object> dashboard = adminReportesServicio.obtenerDashboardGeneral();
            
            log.info("Dashboard generado exitosamente");
            return ResponseEntity.ok(dashboard);
            
        } catch (SecurityException e) {
            log.error("Acceso denegado", e);
            
            Map<String, Object> error = new HashMap<>();
            error.put("error", "Acceso denegado");
            error.put("mensaje", e.getMessage());
            
            return ResponseEntity.status(403).body(error);
            
        } catch (Exception e) {
            log.error("Error obteniendo dashboard", e);
            
            Map<String, Object> error = new HashMap<>();
            error.put("error", "Error al obtener dashboard");
            error.put("mensaje", e.getMessage());
            
            return ResponseEntity.internalServerError().body(error);
        }
    }

